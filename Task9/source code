
#include <stdio.h>

#define SLAB1_UNITS 100
#define SLAB2_UNITS 200

#define RATE1_PAISE 0
#define RATE2_PAISE 225
#define RATE3_PAISE 450

#define FIXED_CHARGE_PAISE 5000L

typedef unsigned short meter_t;

unsigned int calculate_units(meter_t previous, meter_t current)
{
    return (unsigned short)(current - previous);
}

long calculate_bill(unsigned int units)
{
    long energy_charge = 0;

    if (units > SLAB1_UNITS)
    {
        if (units <= SLAB2_UNITS)
        {
            energy_charge =
                (long)(units - SLAB1_UNITS) * RATE2_PAISE;
        }
        else
        {
            energy_charge =
                (long)(SLAB2_UNITS - SLAB1_UNITS) * RATE2_PAISE;

            energy_charge +=
                (long)(units - SLAB2_UNITS) * RATE3_PAISE;
        }
    }

    return energy_charge + FIXED_CHARGE_PAISE;
}

int main(void)
{
    meter_t previous, current;
    unsigned int units;
    long bill;

    printf("===== ELECTRICITY BILLING SYSTEM =====\n");

    printf("Enter previous meter reading: ");
    if (scanf("%hu", &previous) != 1)
    {
        printf("Invalid previous reading!\n");
        return 1;
    }

    printf("Enter current meter reading: ");
    if (scanf("%hu", &current) != 1)
    {
        printf("Invalid current reading!\n");
        return 1;
    }

    units = calculate_units(previous, current);
    bill = calculate_bill(units);

    printf("\n========== BILL DETAILS ==========\n");
    printf("Previous reading : %hu\n", previous);
    printf("Current reading  : %hu\n", current);
    printf("Units consumed   : %u\n", units);

    printf("Energy charge    : Rs %ld.%02ld\n",
           (bill - FIXED_CHARGE_PAISE) / 100,
           (bill - FIXED_CHARGE_PAISE) % 100);

    printf("Fixed charge     : Rs 50.00\n");

    printf("Total bill       : Rs %ld.%02ld\n",
           bill / 100, bill % 100);

    return 0;
}

